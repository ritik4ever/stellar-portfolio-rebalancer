{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "types": [
            "vite/client",
            "vitest/globals"
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/stories",
        "src/**/*.stories.ts",
        "src/**/*.stories.tsx",
        "src/components/upstream_dashboard.tsx"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}