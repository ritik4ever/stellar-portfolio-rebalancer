{
  "ci": {
    "collect": {
      "staticDistDir": "./frontend/dist",
      "url": [
        "http://localhost/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "budgets": [
          {
            "path": "/*",
            "resourceSizes": [
              {
                "resourceType": "script",
                "budget": 300
              },
              {
                "resourceType": "total",
                "budget": 650
              }
            ],
            "timings": [
              {
                "metric": "largest-contentful-paint",
                "budget": 4000
              },
              {
                "metric": "total-blocking-time",
                "budget": 200
              },
              {
                "metric": "cumulative-layout-shift",
                "budget": 0.1
              }
            ]
          }
        ]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 4000
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "performance-budget": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-results"
    }
  }
}
